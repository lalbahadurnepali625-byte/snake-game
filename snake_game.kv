#:kivy 2.3.0

<SnakeApp>:
    # Main application configuration is handled by main.py

<GameBoard>:
    canvas:
        Color:
            rgba: 1, 1, 1, 1

<ControlButton>:
    background_normal: ""
    background_down: ""
    background_color: 0.18, 0.18, 0.18, 0.92
    color: 1, 1, 1, 1
    bold: True